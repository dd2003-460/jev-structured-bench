# ===== 复现配置：复制成 .env 后按你的环境改 =====

# ---- 服务器侧（docker-compose.yml 用）----
# HF 上的模型 id；换任何支持工具调用的 instruct 模型都能跑方法对比
MODEL=Qwen/Qwen3-8B
# 服务暴露的模型名（benchmark 请求里用这个名字）
SERVED_NAME=qwen3.8-27b-w8a16
MAX_MODEL_LEN=8192
# HuggingFace token（gated 模型才需要）
HF_TOKEN=
# HF 缓存目录（避免重复下载大权重）
HF_CACHE=~/.cache/huggingface
# 服务端 api-key（与下面 VLLM_API_KEY 保持一致）
VLLM_API_KEY=sk-local-test

# ---- benchmark 侧（harness 脚本用）----
# vLLM 基址：本机 docker 就是 127.0.0.1:8000；远程就写 http://<ip>:8000
# 注意：不需要任何代理——Path A 的强制工具调用直连 /v1/messages 即可（已实测）
export VLLM_BASE=http://127.0.0.1:8000
export VLLM_MODEL=qwen3.8-27b-w8a16
# export VLLM_API_KEY=sk-local-test
# 评测集目录（默认 ../data/jev-bench，一般不用改）
# export BENCH_DIR=../data/jev-bench
